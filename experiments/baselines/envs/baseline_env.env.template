# 对比系统统一 API 配置模版
#
# 用法：复制本文件为 baseline_env.env，填入真实值。
# 该文件中的变量会被注入所有外部对比系统子进程的环境变量。
# 各系统的桥接脚本据此读取所需密钥/端点（变量名以各系统实际需要为准）。
#
# 五个骨干模型的统一配置（与 experiments/config/backbone.py 的环境变量名对齐）：

# MiniMax
MINIMAX_MODEL=
MINIMAX_BASE_URL=
MINIMAX_API_KEY=

# GPT-4o
GPT4O_MODEL=
GPT4O_BASE_URL=
GPT4O_API_KEY=

# Claude Sonnet
CLAUDE_SONNET_MODEL=
CLAUDE_SONNET_BASE_URL=
CLAUDE_SONNET_API_KEY=

# DeepSeek-V3
DEEPSEEK_V3_MODEL=
DEEPSEEK_V3_BASE_URL=
DEEPSEEK_V3_API_KEY=

# Qwen2.5-72B
QWEN25_72B_MODEL=
QWEN25_72B_BASE_URL=
QWEN25_72B_API_KEY=

# 各对比系统可能额外需要的密钥（按其官方说明补充），例如：
# OPENAI_API_KEY=
# SERPER_API_KEY=
